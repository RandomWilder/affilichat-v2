# Stage 1: Build frontend
FROM node:20-alpine AS frontend-build

WORKDIR /app

# Copy frontend files
COPY package.json package-lock.json ./
RUN npm ci

COPY public/ ./public/
COPY src/ ./src/
COPY index.html vite.config.js tailwind.config.js ./

# Create .env file for Vite with Firebase config
RUN echo "VITE_FIREBASE_API_KEY=AIzaSyCS_dVPBJ3T03gxxmYCoo2P_LoeUZtZw0E\n\
VITE_FIREBASE_AUTH_DOMAIN=affilichat-v2.firebaseapp.com\n\
VITE_FIREBASE_PROJECT_ID=affilichat-v2\n\
VITE_FIREBASE_STORAGE_BUCKET=affilichat-v2.firebasestorage.app\n\
VITE_FIREBASE_MESSAGING_SENDER_ID=234665566004\n\
VITE_FIREBASE_APP_ID=1:234665566004:web:187d26897aea292ab04f61" > .env

# Build frontend
RUN npm run build

# Stage 2: Build backend and combine with frontend
FROM python:3.11-slim

WORKDIR /app

# Install Nginx and other dependencies
RUN apt-get update && apt-get install -y nginx supervisor gettext-base && \
    rm -rf /var/lib/apt/lists/* && \
    rm /etc/nginx/sites-enabled/default

# Create a non-root user for running the application
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Set up directories with proper permissions
RUN mkdir -p /var/log/nginx /var/lib/nginx /run/nginx && \
    chown -R appuser:appuser /var/log/nginx /var/lib/nginx /run/nginx && \
    chmod -R 755 /var/log/nginx /var/lib/nginx

# Copy Python requirements and install dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY app.py rag_chat.py crawler.py main.py ./
COPY src ./src/
COPY config ./config/

# Copy Nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy Firebase config template
COPY firebase-config-template.js /tmp/

# Create a startup script that will inject Firebase config at runtime
RUN echo '#!/bin/bash\n\
# Process the Firebase config template and inject environment variables\n\
envsubst < /tmp/firebase-config-template.js > /usr/share/nginx/html/firebase-config.js\n\
# Ensure proper permissions\n\
chown -R appuser:appuser /usr/share/nginx/html\n\
# Start supervisor with specific config file\n\
exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf\n\
' > /app/start.sh && chmod +x /app/start.sh

# Create supervisor config with user specification and authentication
RUN echo "[supervisord]\n\
nodaemon=true\n\
user=root\n\
logfile=/var/log/supervisor/supervisord.log\n\
pidfile=/var/run/supervisord.pid\n\
\n\
[unix_http_server]\n\
file=/var/run/supervisor.sock\n\
chmod=0700\n\
username=supervisor\n\
password=supervisor_pass\n\
\n\
[program:nginx]\n\
command=nginx -g 'daemon off;'\n\
autostart=true\n\
autorestart=true\n\
stdout_logfile=/dev/stdout\n\
stdout_logfile_maxbytes=0\n\
stderr_logfile=/dev/stderr\n\
stderr_logfile_maxbytes=0\n\
\n\
[program:flask]\n\
command=gunicorn --bind 127.0.0.1:5000 app:app\n\
directory=/app\n\
user=appuser\n\
autostart=true\n\
autorestart=true\n\
stdout_logfile=/dev/stdout\n\
stdout_logfile_maxbytes=0\n\
stderr_logfile=/dev/stderr\n\
stderr_logfile_maxbytes=0\n\
" > /etc/supervisor/conf.d/supervisord.conf

# Create necessary directories for supervisor
RUN mkdir -p /var/log/supervisor /var/run && \
    chown -R appuser:appuser /app

# Copy frontend build from stage 1
COPY --from=frontend-build /app/dist /usr/share/nginx/html
RUN chown -R appuser:appuser /usr/share/nginx/html

# Copy firebase key json if it exists (for testing)
COPY firebase-key.json* ./
RUN if [ -f firebase-key.json ]; then chown appuser:appuser firebase-key.json; fi

# Ensure nginx can access the html directory
RUN chmod -R 755 /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Start services using the startup script
CMD ["/app/start.sh"] 