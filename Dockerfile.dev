# Development environment configuration
FROM python:3.12-slim-bookworm

# Set working directory for application code
WORKDIR /app

# Environment variables for development configuration
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FLASK_ENV=development \
    FLASK_DEBUG=1 \
    PORT=5000

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Pre-install development tools
RUN pip install --no-cache-dir \
    pytest \
    pytest-asyncio \
    black \
    flake8 \
    ipython \
    flask \
    gunicorn

# Copy application requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Create necessary directories with appropriate permissions
RUN mkdir -p ./personas && chmod 777 ./personas
RUN mkdir -p ./logs && chmod 777 ./logs

# Expose development port
EXPOSE 5000

# Command to run the development server with hot-reload
CMD ["python", "app.py"]