# Production environment configuration
FROM python:3.12-slim-bookworm

# Set working directory for application code
WORKDIR /app

# Environment variables for production configuration
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements file
COPY requirements.txt .

# Install Python dependencies - maintaining direct alignment with dev pattern
RUN pip install --no-cache-dir -r requirements.txt

# Install Brotli for content decoding
RUN pip install --no-cache-dir brotli

# Install production WSGI server
RUN pip install --no-cache-dir gunicorn

# Create necessary directories with appropriate permissions
RUN mkdir -p ./personas && chmod 777 ./personas
RUN mkdir -p ./logs && chmod 777 ./logs

# Copy application code
COPY . .

# Expose production port
EXPOSE 8080

# Command to run the production server with gunicorn
CMD ["sh", "-c", "gunicorn --bind 0.0.0.0:${PORT} --workers 2 --timeout 120 --threads 2 'app:app'"]